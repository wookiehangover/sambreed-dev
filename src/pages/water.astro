---
export const prerender = true;

const title = "Water — Sam Breed";
const description = "A quiet ocean, a silver reflection, and a hazy sky. An animated study of water and light.";
const pageUrl = new URL("/water", Astro.site);
const imageUrl = new URL("/img/water-share.jpg", Astro.site);
const imageAlt = "Silver sunlight shimmering across a dark ocean beneath a hazy gray sky.";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#555858" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={pageUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1024" />
		<meta property="og:image:height" content="768" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />
	</head>
	<body>
		<main>
			<water-scene>
				<canvas
					role="img"
					aria-label="Dark ocean ripples beneath a hazy gray sky, with silver sunlight shimmering across the right side of the water."
				></canvas>
			</water-scene>
		</main>
		<script>
			import "~/components/water/scene";
		</script>
	</body>
</html>

<style>
	:global(html) {
		background: #555858;
		color-scheme: dark;
	}
	:global(body) {
		margin: 0;
	}
	water-scene {
		display: block;
		position: fixed;
		inset: 0;
		overflow: hidden;
		background: linear-gradient(180deg, #505558 0%, #77786e 45%, #a19e87 55.5%, #424440 56%, #161c1d 100%);
	}
	canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
	canvas[hidden] {
		display: none;
	}
</style>
