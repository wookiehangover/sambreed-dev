</html>

<style>
	:global(html) {
		background: #555858;
		color-scheme: dark;
	}
	:global(body) {
		margin: 0;
	}
	water-scene {
		display: block;
		position: fixed;
		inset: 0;
		overflow: hidden;
		background: linear-gradient(180deg, #505558 0%, #77786e 45%, #a19e87 55.5%, #424440 56%, #161c1d 100%);
	}
	canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
	canvas[hidden] {
		display: none;
	}
</style>
