<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Water — Sam Breed</title>
		<meta
			name="description"
			content="A quiet ocean, a silver reflection, and a hazy sky. An animated study of water and light."
		/>
		<meta name="theme-color" content="#555858" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={new URL("/water", Astro.site)} />
	</head>
	<body>
		<main>
			<water-scene>
				<canvas
					role="img"
					aria-label="Dark ocean ripples beneath a hazy gray sky, with silver sunlight shimmering across the right side of the water."
				></canvas>
			</water-scene>
		</main>
		<script>
			import "~/components/water/scene";
		</script>
