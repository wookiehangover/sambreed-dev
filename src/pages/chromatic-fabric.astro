---
export const prerender = true;

const title = "Chromatic Fabric — Sam Breed";
const description =
	"A hanging sheet of chromatic threads. Hover to ripple it, drag to bunch it up and throw it around.";
const pageUrl = new URL("/chromatic-fabric", Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#000000" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={pageUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
	</head>
	<body>
		<main>
			<chromatic-fabric>
				<canvas
					role="img"
					aria-label="A sheet of fine red, green, and blue threads hangs from its top edge against black, splitting into rainbow fringes where it folds. Hover to ripple it; drag to bunch it up and throw it."
				></canvas>
			</chromatic-fabric>
		</main>
		<script>
			import "~/components/chromatic-fabric/scene";
		</script>
	</body>
</html>

<style>
	:global(html) {
		background: #000;
		color-scheme: dark;
	}
	:global(body) {
		margin: 0;
	}
	chromatic-fabric {
		display: block;
		position: fixed;
		inset: 0;
		overflow: hidden;
		background: #000;
	}
	canvas {
		display: block;
		width: 100%;
		height: 100%;
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
	}
	canvas[data-hover] {
		cursor: grab;
	}
	canvas[data-grabbing] {
		cursor: grabbing;
	}
	canvas[hidden] {
		display: none;
	}
</style>
