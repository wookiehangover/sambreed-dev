---
import { getEntry, render } from "astro:content";
import BlogPost from "~/layouts/BlogPost.astro";

const { slug } = Astro.params;
if (slug === undefined) {
	return Astro.redirect("/writing");
}

// Try to find entry - some legacy files have .html in their collection ID
// even though the route doesn't include .html
let entry = await getEntry("writing", slug);
if (entry === undefined) {
	// Try with .html suffix for legacy .html.md files
	entry = await getEntry("writing", `${slug}.html`);
}

if (entry === undefined) {
	return Astro.redirect("/404");
}

const { Content } = await render(entry);
---

<BlogPost content={{ ...entry.data, slug }}>
	<Content />
</BlogPost>
